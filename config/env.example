# Copy to config/env.local and set paths for your machine.
# config/env.local is gitignored.

export ORB_SLAM3_ROOT=/path/to/ORB_SLAM3

# YOLO latency benchmark (optional unless running benchmark_yolo.py)
export YOLO_PT_MODEL=/path/to/yolov8n.pt
export YOLO_HEF_MODEL=/path/to/yolov8n.hef
export YOLO_DETECTOR_SRC=/path/to/yolo_detector
